---
type Props = { size?: number };
const { size = 26 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="instagram-gradient" x1="4" y1="28" x2="28" y2="4" gradientUnits="userSpaceOnUse">
      <stop stop-color="#ffdc80" />
      <stop offset="0.25" stop-color="#fcaf45" />
      <stop offset="0.5" stop-color="#f77737" />
      <stop offset="0.72" stop-color="#e1306c" />
      <stop offset="1" stop-color="#833ab4" />
    </linearGradient>
  </defs>
  <g class="instagram-mono">
    <rect x="3.25" y="3.25" width="25.5" height="25.5" rx="7.5" stroke="currentColor" stroke-width="3.5" />
    <circle cx="16" cy="16" r="6.1" stroke="currentColor" stroke-width="3.5" />
    <circle cx="24.2" cy="7.9" r="2" fill="currentColor" />
  </g>
  <g class="instagram-color">
    <rect x="3.25" y="3.25" width="25.5" height="25.5" rx="7.5" stroke="url(#instagram-gradient)" stroke-width="3.5" />
    <circle cx="16" cy="16" r="6.1" stroke="url(#instagram-gradient)" stroke-width="3.5" />
    <circle cx="24.2" cy="7.9" r="2" fill="url(#instagram-gradient)" />
  </g>
</svg>
