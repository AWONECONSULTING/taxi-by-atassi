---
import Icon from "./Icon.astro";
import ServiceIcon from "./ServiceIcon.astro";
import BenefitIcon from "./BenefitIcon.astro";
import StatIcon from "./StatIcon.astro";
import InstagramIcon from "./InstagramIcon.astro";
import { siteConfig } from "../config/site";
import { serviceAreas, type Location } from "../data/locations";

type Props = {
  location: Location;
};

const { location } = Astro.props;
const [streetAddress, postalAddress] = siteConfig.address.split(",").map((part) => part.trim());

const slides = [
  {
    image: "/images/hero-coucher-soleil.webp",
    title: location.heroTitle,
    text: location.heroText,
  },
  {
    image: "/images/hero-nuit.webp",
    title: "Déplacez-vous librement, à toute heure",
    text: "Un taxi rapide et confortable pour tous vos trajets du quotidien",
  },
  {
    image: "/images/hero-lever-soleil.webp",
    title: "Vos rendez-vous médicaux en toute sérénité",
    text: "Transport agréé par la Sécurité sociale, fiable et ponctuel",
  },
  {
    image: "/images/hero-professionnel.webp",
    title: "Un accompagnement sûr et encadré",
    text: "Pour les élèves et bénéficiaires du Conseil Départemental",
  },
];

const partners = [
  { src: "/images/partners/bmw.webp", alt: "BMW" },
  { src: "/images/partners/assurance-maladie.webp", alt: "Assurance Maladie" },
  { src: "/images/partners/castanet-tolosan.webp", alt: "Ville de Castanet-Tolosan" },
  { src: "/images/partners/haute-garonne.webp", alt: "Conseil départemental de la Haute-Garonne" },
  { src: "/images/partners/asei.webp", alt: "ASEI" },
  { src: "/images/partners/sessad.webp", alt: "SESSAD" },
  { src: "/images/partners/awone.webp", alt: "Awone" },
];

const services = [
  {
    number: "01",
    icon: "taxi" as const,
    title: "Taxi Pure",
    text: "Trajets du quotidien : déplacements privés ou professionnels, en toute simplicité. Disponible 7j/7.",
    href: "#particulier",
  },
  {
    number: "02",
    icon: "medical" as const,
    title: "Taxi Conventionné (VSL)",
    text: "Transport médical pris en charge par la Sécurité sociale. Pour vos rendez-vous et soins réguliers.",
    href: "#vsl",
  },
  {
    number: "03",
    icon: "school" as const,
    title: "Transport Scolaire",
    text: "Transport encadré pour élèves et bénéficiaires du Conseil Départemental. Sécurité garantie.",
    href: "#scolaire",
  },
];
---

<header class="site-header">
  <div class="header-top shell">
    <a class="top-contact" href={`mailto:${siteConfig.email}`}>
      <Icon name="mail" size={16} />
      <span>{siteConfig.email}</span>
    </a>
  </div>
  <div class="nav-wrap shell">
    <a class="nav-logo" href="/" aria-label="Taxi by Atassi, accueil">
      <img src="/images/logo-nav.png" width="1000" height="452" alt="Taxi by Atassi" />
    </a>
    <button class="menu-toggle" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="main-nav" data-menu-toggle>
      <Icon name="menu" />
    </button>
    <div class="nav-drawer-clip">
      <nav id="main-nav" class="main-nav" aria-label="Navigation principale" data-nav>
        <a href="#accueil">Accueil</a>
        <a href="#partenaires">Nos partenaires</a>
        <a href="#reservation">Réserver une course</a>
        <div class="nav-services-group">
          <div class="nav-services-row">
            <a class="nav-services-link" href="#services">Nos services</a>
            <button class="nav-services-toggle" type="button" aria-label="Afficher les sous-menus de Nos services" aria-expanded="false" aria-controls="nav-services-submenu" data-services-toggle>
              <Icon name="arrow" size={16} />
            </button>
          </div>
          <div id="nav-services-submenu" class="nav-services-submenu" data-services-submenu>
            <a href="#particulier">Taxi Pure</a>
            <a href="#vsl">Taxi VSL</a>
            <a href="#scolaire">Transport scolaire</a>
          </div>
        </div>
        <a href="#zones">Zones desservies</a>
        <a class="nav-menu-email" href={`mailto:${siteConfig.email}`}>
          <Icon name="mail" size={18} />
          <span>{siteConfig.email}</span>
        </a>
        <a class="nav-menu-phone" href={`https://wa.me/${siteConfig.phoneRaw}`} target="_blank" rel="noopener noreferrer" aria-label={`Contacter Taxi by Atassi sur WhatsApp au ${siteConfig.phoneDisplay}`}>
          <Icon name="whatsapp" size={21} />
          <span>{siteConfig.phoneDisplay}</span>
        </a>
      </nav>
    </div>
    <a class="nav-phone" href={`https://wa.me/${siteConfig.phoneRaw}`} target="_blank" rel="noopener noreferrer" aria-label={`Contacter Taxi by Atassi au ${siteConfig.phoneDisplay}`}>
      <span class="nav-phone-icon"><Icon name="whatsapp" size={26} /></span>
      <span>+33636376596</span>
    </a>
  </div>
</header>

<div class="page-scroll" data-page-scroll>
<main>
  <section id="accueil" class="hero" aria-label="Présentation" data-hero>
    {slides.map((slide, index) => (
      <article class:list={["hero-slide", { active: index === 0 }]} data-hero-slide aria-hidden={index === 0 ? "false" : "true"}>
        <img src={slide.image} width="1368" height="768" alt="" fetchpriority={index === 0 ? "high" : "auto"} loading={index === 0 ? "eager" : "lazy"} />
        <div class="hero-overlay"></div>
        <div class="hero-content shell">
          {index === 0 ? <h1>{slide.title}</h1> : <h2>{slide.title}</h2>}
          <p class="hero-copy">{slide.text}</p>
          <a class="button button-primary hero-button" href="#reservation">Réserver maintenant</a>
        </div>
      </article>
    ))}
    <button class="hero-arrow hero-prev" type="button" aria-label="Voir le visuel précédent" data-hero-prev><Icon name="arrow" size={36} /></button>
    <button class="hero-arrow hero-next" type="button" aria-label="Voir le visuel suivant" data-hero-next><Icon name="arrow" size={36} /></button>
  </section>

  <section id="partenaires" class="partners" aria-labelledby="partners-title">
    <div class="section-heading shell reveal">
      <p class="eyebrow">Ils nous font confiance</p>
      <h2 id="partners-title">Nos partenaires</h2>
    </div>
    <div class="partner-marquee" data-marquee>
      <div class="partner-track">
        {[...partners, ...partners].map((partner, index) => (
          <div class="partner-logo" aria-hidden={index >= partners.length ? "true" : undefined}>
            <img src={partner.src} width="300" height="300" alt={index < partners.length ? partner.alt : ""} loading="eager" decoding="async" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="reservation" class="reservation dark-section">
    <div class="reservation-inner shell">
      <div class="reservation-copy reveal">
        <p class="eyebrow light">Vous cherchez un taxi ?</p>
        <h2>Réservez votre course</h2>
        <p>{location.bookingText}</p>
        <div class="availability"><span class="status-pulse"></span> Réservation simple et directe via WhatsApp</div>
      </div>
      <form class="booking-form reveal" data-booking-form>
        <label><span>Votre nom</span><input type="text" name="name" autocomplete="name" placeholder="Votre nom" required /></label>
        <label><span>Votre téléphone</span><input type="tel" name="phone" autocomplete="tel" placeholder="Votre téléphone" required /></label>
        <label><span>Nombre de passagers</span><input type="number" name="passengers" min="1" max="8" placeholder="Nombre de passagers" required /></label>
        <label><span>Adresse de départ</span><input type="text" name="departure" autocomplete="street-address" placeholder="Adresse de départ" required /></label>
        <label><span>Adresse d’arrivée</span><input type="text" name="arrival" placeholder="Adresse d’arrivée" required /></label>
        <label><span>Date souhaitée</span><input type="date" name="date" required /></label>
        <label><span>Heure souhaitée</span><input type="time" name="time" required /></label>
        <button class="button button-primary booking-submit" type="submit">Réserver maintenant <Icon name="arrow" size={19} /></button>
        <p class="form-note" data-form-note aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section id="services" class="services" aria-labelledby="services-title">
    <div class="section-heading shell reveal">
      <p class="eyebrow">Des prestations adaptées à tous vos besoins</p>
      <h2 id="services-title">Nos services à votre disposition</h2>
    </div>
    <div class="service-grid shell">
      {services.map((service) => (
        <div class="service-card-wrap reveal">
          <a class="service-card" href={service.href}>
            <div class="service-card-top"><span>{service.number}</span><ServiceIcon name={service.icon} size={72} /></div>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
            <span class="service-link">Découvrir <Icon name="arrow" size={18} /></span>
          </a>
        </div>
      ))}
    </div>
  </section>

  <section class="service-details shell">
    <article id="particulier" class="detail-row reveal">
      <div class="detail-copy">
        <p class="eyebrow">Vos trajets du quotidien</p>
        <h2>Taxi particuliers<br />et professionnels</h2>
        <p>{location.classicText}</p>
        <ul class="check-list">
          <li><Icon name="check" size={18} /> BMW Série 5 haut de gamme, confortable et sécurisée</li>
          <li><Icon name="check" size={18} /> Disponible 24h/24, sur réservation ou demande immédiate</li>
          <li><Icon name="check" size={18} /> Chauffeur professionnel, discret et ponctuel</li>
        </ul>
        <a class="text-link" href="#reservation">Organiser mon trajet <Icon name="arrow" size={18} /></a>
      </div>
      <figure class="detail-media"><div class="detail-image-clip"><img src="/images/service-taxi.webp" width="1024" height="1024" alt="Véhicule Taxi by Atassi à Toulouse" loading="lazy" /></div><span class="media-index">01</span></figure>
    </article>

    <article id="vsl" class="detail-row reverse reveal">
      <div class="detail-copy">
        <p class="eyebrow">Pour vos rendez-vous médicaux</p>
        <h2>Taxi conventionné (VSL)</h2>
        <p>{location.medicalText}</p>
        <ul class="check-list">
          <li><Icon name="check" size={18} /> Prise en charge possible à 65 % ou 100 % selon votre situation</li>
          <li><Icon name="check" size={18} /> Accompagnement adapté aux personnes fragiles ou à mobilité réduite</li>
          <li><Icon name="check" size={18} /> Trajets calmes, sécurisés et ponctuels en région toulousaine</li>
        </ul>
        <a class="text-link" href="#reservation">Préparer mon transport <Icon name="arrow" size={18} /></a>
      </div>
      <figure class="detail-media"><div class="detail-image-clip"><img src="/images/service-medical.webp" width="1024" height="1024" alt="Accompagnement pour un transport médical conventionné" loading="lazy" /></div><span class="media-index">02</span></figure>
    </article>

    <article id="scolaire" class="detail-row reveal">
      <div class="detail-copy">
        <p class="eyebrow">Un transport sûr et encadré</p>
        <h2>Transport scolaire</h2>
        <p>{location.schoolText}</p>
        <ul class="check-list">
          <li><Icon name="check" size={18} /> Horaires planifiés et respectés avec rigueur</li>
          <li><Icon name="check" size={18} /> Accompagnement adapté et conforme aux exigences départementales</li>
          <li><Icon name="check" size={18} /> Possibilité de privatiser un véhicule selon les besoins de l’enfant</li>
        </ul>
        <a class="text-link" href="#reservation">Échanger sur vos besoins <Icon name="arrow" size={18} /></a>
      </div>
      <figure class="detail-media"><div class="detail-image-clip"><img src="/images/service-scolaire.webp" width="1024" height="1024" alt="Transport scolaire accompagné en Haute-Garonne" loading="lazy" /></div><span class="media-index">03</span></figure>
    </article>
  </section>

  <section id="zones" class="local-zone" aria-labelledby="service-areas-title">
    <div class="local-zone-inner shell reveal">
      <div>
        <p class="eyebrow light">{location.localEyebrow}</p>
        <h2 id="service-areas-title">{location.localTitle}</h2>
      </div>
      <div class="local-zone-content">
        <p>{location.localText}</p>
        <ul class="service-area-list" aria-label="Principales zones desservies">
          {serviceAreas.map((area) => (
            <li>
              <a href={area.url}>{area.label}<Icon name="arrow" size={15} /></a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <div class="section-bridge" aria-hidden="true">
    <div class="section-bridge-inner shell">
      <span class="section-bridge-line"></span>
      <span class="section-bridge-mark">
        <svg class="section-bridge-outline" viewBox="0 0 250 68" preserveAspectRatio="none">
          <path class="bridge-outline-split" pathLength="1" d="M 1 34 A 33 33 0 0 1 34 1 H 125" />
          <path class="bridge-outline-split" pathLength="1" d="M 1 34 A 33 33 0 0 0 34 67 H 125" />
          <path class="bridge-outline-split" pathLength="1" d="M 249 34 A 33 33 0 0 0 216 1 H 125" />
          <path class="bridge-outline-split" pathLength="1" d="M 249 34 A 33 33 0 0 1 216 67 H 125" />
          <path class="bridge-outline-wide" pathLength="1" d="M 0 34 A 34 34 0 0 1 34 0 H 125.4" />
          <path class="bridge-outline-wide" pathLength="1" d="M 0 34 A 34 34 0 0 0 34 68 H 125.4" />
          <path class="bridge-outline-wide" pathLength="1" d="M 250 34 A 34 34 0 0 0 216 0 H 124.6" />
          <path class="bridge-outline-wide" pathLength="1" d="M 250 34 A 34 34 0 0 1 216 68 H 124.6" />
        </svg>
        <img src="/images/logo.webp" width="500" height="114" alt="" />
      </span>
      <span class="section-bridge-line"></span>
    </div>
  </div>

  <section id="pourquoi-nous" class="why-us dark-section" aria-labelledby="why-title">
    <div class="section-heading shell reveal"><p class="eyebrow light">Voyagez l’esprit tranquille</p><h2 id="why-title">Pourquoi choisir Taxi by Atassi ?</h2></div>
    <div class="benefit-grid shell">
      <article class="benefit reveal"><span class="benefit-icon"><BenefitIcon name="insurance" /></span><h3>Sécurité avant tout</h3><p>Nos véhicules sont entretenus avec rigueur et respectent toutes les normes pour garantir des trajets sûrs et sereins.</p></article>
      <article class="benefit reveal"><span class="benefit-icon"><BenefitIcon name="seatbelt" /></span><h3>Chauffeurs professionnels</h3><p>Expérimentés, courtois et à l’écoute, nos chauffeurs vous accompagnent avec sérieux et respect.</p></article>
      <article class="benefit reveal"><span class="benefit-icon"><BenefitIcon name="consent" /></span><h3>Ponctualité garantie</h3><p>Nous savons que votre temps est précieux. C’est pourquoi nous nous engageons à être toujours à l’heure.</p></article>
    </div>
  </section>

  <section id="chiffres" class="figures" aria-labelledby="figures-title">
    <div class="section-heading shell reveal"><p class="eyebrow">Nos chiffres clés</p><h2 id="figures-title">Les chiffres parlent d’eux-mêmes</h2></div>
    <div class="figure-grid shell">
      <div class="figure-card reveal"><span class="figure-icon"><StatIcon name="meter" /></span><strong aria-label="Plus d’un million"><span aria-hidden="true">+ </span><span data-counter data-counter-value="1" aria-hidden="true">0</span><span aria-hidden="true">M</span></strong><span class="figure-label">Kilomètres parcourus</span></div>
      <div class="figure-card reveal"><span class="figure-icon"><StatIcon name="team" /></span><strong aria-label="Plus de 2 599"><span aria-hidden="true">+ </span><span data-counter data-counter-value="2599" aria-hidden="true">0</span></strong><span class="figure-label">Personnes transportées</span></div>
      <div class="figure-card reveal"><span class="figure-icon"><StatIcon name="taxi" /></span><strong aria-label="Plus de quatre"><span aria-hidden="true">+ </span><span data-counter data-counter-value="4" aria-hidden="true">0</span></strong><span class="figure-label">Taxis et chauffeurs</span></div>
      <div class="figure-card reveal"><span class="figure-icon"><StatIcon name="happy" /></span><strong aria-label="99 pour cent"><span data-counter data-counter-value="99" aria-hidden="true">0</span><span aria-hidden="true">%</span></strong><span class="figure-label">Clients satisfaits</span></div>
    </div>
  </section>

  <section class="final-cta" data-final-cta>
    <img src="/images/voiture-3.webp" width="1368" height="768" alt="" loading="lazy" />
    <div class="final-cta-overlay"></div>
    <div class="final-cta-content shell reveal"><p class="eyebrow light">Service disponible 24 heures sur 24</p><h2><span>Contactez-nous dès maintenant et réservez</span><span>votre taxi pour votre prochain trajet</span></h2><div class="hero-actions"><a class="button button-primary hero-button" href="#reservation">Je réserve ma course</a></div></div>
  </section>
</main>

<footer id="contact" class="site-footer">
  <div class="footer-grid shell">
    <div class="footer-brand"><img src="/images/logo.webp" width="500" height="114" alt="Taxi by Atassi" /><p>Service de taxi professionnel disponible 24h/24 pour les transports classiques, médicaux et scolaires.</p><a class="footer-social" href={siteConfig.instagram} target="_blank" rel="noreferrer" aria-label="Taxi by Atassi sur Instagram"><InstagramIcon /></a></div>
    <div><h2>Services</h2><ul><li><a href="#particulier">Taxi classique</a></li><li><a href="#vsl">Taxi conventionné</a></li><li><a href="#scolaire">Transport scolaire</a></li><li><a href="#reservation">Réserver une course</a></li></ul></div>
    <div><h2>Zones desservies</h2><ul>{serviceAreas.map((item) => <li><a href={item.url}>{item.label}</a></li>)}</ul></div>
    <div><h2>Contact</h2><address><span class="footer-address"><span>{streetAddress}</span><span>{postalAddress}</span></span><a class="footer-contact-link" href={`mailto:${siteConfig.email}`}><Icon name="mail" size={19} /><strong>{siteConfig.email}</strong></a><a class="footer-contact-link" href={`tel:${siteConfig.phoneInternational}`}><Icon name="phone" size={19} /><strong>{siteConfig.phoneDisplay}</strong></a></address></div>
  </div>
  <div class="footer-bottom shell"><span>© {new Date().getFullYear()} Taxi by Atassi</span><span>Conçu avec soin par <a href="https://www.awone.fr/" target="_blank" rel="noreferrer">Awone</a></span></div>
</footer>
</div>

<div class="floating-controls">
  <a
    class="floating-whatsapp"
    href={`https://wa.me/${siteConfig.phoneRaw}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contacter Taxi by Atassi sur WhatsApp"
  ><Icon name="whatsapp" size={25} /></a>
  <button class="back-to-top" type="button" aria-label="Revenir en haut" data-back-to-top>↑</button>
</div>

<script>
  import "../scripts/landing.ts?locked-mobile-viewport=1";
</script>
