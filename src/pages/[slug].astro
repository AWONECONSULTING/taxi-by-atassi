---
import LandingPage from "../components/LandingPage.astro";
import { getLocalPageLocations, type Location } from "../data/locations";
import BaseLayout from "../layouts/BaseLayout.astro";
import { createTaxiServiceJsonLd } from "../utils/seo";

export function getStaticPaths() {
  return getLocalPageLocations().map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

type Props = {
  location: Location;
};

const { location } = Astro.props;
---

<BaseLayout title={location.title} description={location.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(createTaxiServiceJsonLd(location))}></script>
  <LandingPage location={location} />
</BaseLayout>
